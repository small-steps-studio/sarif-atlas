{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Example Analyzer",
          "version": "2.3.0",
          "rules": [
            {
              "id": "EX001",
              "name": "NoEval",
              "shortDescription": {
                "text": "Avoid eval"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "EX002",
              "name": "UnusedVar",
              "shortDescription": {
                "text": "Unused variable"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "EX003",
              "name": "LongLine",
              "shortDescription": {
                "text": "Line too long"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "EX004",
              "name": "SqlConcat",
              "shortDescription": {
                "text": "SQL built by string concatenation"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "EX005",
              "name": "WeakHash",
              "shortDescription": {
                "text": "Weak hash algorithm"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "EX006",
              "name": "HardcodedSecret",
              "shortDescription": {
                "text": "Hard-coded credential"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "EX007",
              "name": "MissingCsrf",
              "shortDescription": {
                "text": "Form without CSRF token"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "EX008",
              "name": "Todo",
              "shortDescription": {
                "text": "Leftover TODO comment"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "EX007",
          "message": {
            "text": "form without csrf token here"
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cmd/server/main.go"
                },
                "region": {
                  "startLine": 134,
                  "startColumn": 22
                }
              }
            }
          ],
          "baselineState": "unchanged"
        },
        {
          "ruleId": "EX008",
          "message": {
            "text": "leftover todo comment here"
          },
          "level": "none",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "cmd/server/main.go"
                },
                "region": {
                  "startLine": 133,
                  "startColumn": 25
                }
              }
            }
          ],
          "baselineState": "unchanged"
        },
        {
          "ruleId": "EX003",
          "message": {
            "text": "line too long here"
          },
          "level": "none",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/deploy.sh"
                }
              }
            }
          ],
          "baselineState": "unchanged"
        },
        {
          "ruleId": "EX008",
          "message": {
            "text": "leftover todo comment here"
          },
          "baselineState": "new"
        },
        {
          "ruleId": "EX006",
          "message": {
            "text": "hard-coded credential here"
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lib/db/query.py"
                },
                "region": {
                  "startLine": 217,
                  "startColumn": 44
                }
              }
            }
          ],
          "baselineState": "absent"
        },
        {
          "ruleId": "EX001",
          "message": {
            "text": "avoid eval here"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/util.js"
                },
                "region": {
                  "startLine": 52,
                  "startColumn": 33
                }
              }
            }
          ],
          "baselineState": "new"
        }
      ]
    }
  ]
}