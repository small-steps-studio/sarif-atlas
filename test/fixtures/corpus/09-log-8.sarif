{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Example Analyzer",
          "version": "2.5.0",
          "rules": [
            {
              "id": "EX001",
              "name": "NoEval",
              "shortDescription": {
                "text": "Avoid eval"
              }
            },
            {
              "id": "EX002",
              "name": "UnusedVar",
              "shortDescription": {
                "text": "Unused variable"
              }
            },
            {
              "id": "EX003",
              "name": "LongLine",
              "shortDescription": {
                "text": "Line too long"
              }
            },
            {
              "id": "EX004",
              "name": "SqlConcat",
              "shortDescription": {
                "text": "SQL built by string concatenation"
              }
            },
            {
              "id": "EX005",
              "name": "WeakHash",
              "shortDescription": {
                "text": "Weak hash algorithm"
              }
            },
            {
              "id": "EX006",
              "name": "HardcodedSecret",
              "shortDescription": {
                "text": "Hard-coded credential"
              }
            },
            {
              "id": "EX007",
              "name": "MissingCsrf",
              "shortDescription": {
                "text": "Form without CSRF token"
              }
            },
            {
              "id": "EX008",
              "name": "Todo",
              "shortDescription": {
                "text": "Leftover TODO comment"
              }
            }
          ]
        }
      },
