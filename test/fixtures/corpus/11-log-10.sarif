{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Example Analyzer",
          "version": "2.2.0",
          "rules": [
            {
              "id": "EX001",
              "name": "NoEval",
              "shortDescription": {
                "text": "Avoid eval"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "EX002",
              "name": "UnusedVar",
              "shortDescription": {
                "text": "Unused variable"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "EX003",
              "name": "LongLine",
              "shortDescription": {
                "text": "Line too long"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "EX004",
              "name": "SqlConcat",
              "shortDescription": {
                "text": "SQL built by string concatenation"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "EX005",
              "name": "WeakHash",
              "shortDescription": {
                "text": "Weak hash algorithm"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "EX006",
              "name": "HardcodedSecret",
              "shortDescription": {
                "text": "Hard-coded credential"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "EX007",
              "name": "MissingCsrf",
              "shortDescription": {
                "text": "Form without CSRF token"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "EX008",
              "name": "Todo",
              "shortDescription": {
                "text": "Leftover TODO comment"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            }
          ]
        }
      },
