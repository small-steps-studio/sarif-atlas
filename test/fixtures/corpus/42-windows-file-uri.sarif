{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Example Analyzer",
          "version": "1.0.0"
        }
      },
      "results": [
        {
          "ruleId": "EX001",
          "message": {
            "text": "a"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file:///D:/repo/src/a%20b.js"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ]
        },
        {
          "ruleId": "EX001",
          "message": {
            "text": "b"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file:///home/dev/repo/x.js"
                }
              }
            }
          ]
        },
        {
          "ruleId": "EX001",
          "message": {
            "text": "c"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "file:///bad%E0%A4%A.js"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}